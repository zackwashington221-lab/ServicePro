# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Admin seed (used by `npm run seed:admin`)
ADMIN_NAME=ServicePro Administrator
ADMIN_EMAIL=admin@servicepro.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/servicepro?retryWrites=true&w=majority

# Cryptographic keys: generate unique values with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-a-unique-64-character-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-64-character-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Security configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
GEMINI_API_KEY=
GEMINI_REPORT_MODEL=gemini-2.0-flash
